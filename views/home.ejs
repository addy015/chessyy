<!-- What this file does:
     Homepage Template (rendered when visiting '/').
-->
<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head', { title: title, extraCss: ['home.css'] }) %>
</head>

<body>
    <%- include('partials/masthead') %>

    <main class="home-container">
        <!-- 12-Column Background Grid Lines (visual design motif) -->
        <div class="editorial-grid-overlay">
            <% for(let i=0; i < 12; i++) { %>
                <div class="editorial-grid-line"></div>
            <% } %>
        </div>

        <section class="home-hero">
            <!-- Left Hero Content: Headline, Subtitle, and Call To Action -->
            <div class="hero-content">
                <h1 class="hero-title">
                    THE ARCHITECTURE<br>
                    OF <span class="title-accent">THOUGHT.</span>
                </h1>

                <p class="hero-subtext">
                    64 squares. 32 pieces. Two minds locked in silence. A real-time multiplayer arena. <br>Just 2 players trying to outthink each other before the flag falls.
                </p>

                <!-- Start Playing Buttons -->
                <div class="cta-wrapper">
                    <a href="/play" class="btn-play-now" id="home-play-cta">
                        <span>PLAY NOW</span>                        
                    </a>
                    <button type="button" class="btn-play-friends" id="home-friends-cta">
                        <span>PLAY WITH A FRIEND</span>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2" stroke-linecap="square" stroke-linejoin="miter">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Right Visual: Abstract 8x8 Matrix Composition -->
            <div class="home-visual">
                <div class="abstract-board-matrix" id="hero-matrix" title="64 SQUARES / ABSTRACT GEOMETRY">
                    <!-- Generates 64 grid cells; sampleAccents highlights center squares (e4, d4, e5, d5) -->
                    <% const sampleAccents=[27, 28, 35, 36, 18, 45]; 
                       for(let r=0; r < 8; r++) { 
                           for(let c=0; c < 8; c++) { 
                               const idx = r * 8 + c; 
                               const isShaded = (r + c) % 2 === 1; 
                               const isAccent = sampleAccents.includes(idx); %>
                        <div class="matrix-cell <%= isShaded ? 'shaded' : '' %> <%= isAccent ? 'active-accent' : '' %>"
                            data-coord="<%= String.fromCharCode(97 + c) %><%= 8 - r %>">
                            <% if(isAccent) { %>
                                &bull;
                            <% } %>
                        </div>
                    <% } } %>
                </div>
                <!-- Dynamic coordinate text updated by home.js on mouse hover -->
                <div class="matrix-caption">
                    <span>CENTER OCCUPATION</span>
                    <span>COORDINATES [E4, D4, E5, D5]</span>
                </div>
            </div>
        </section>
    </main>

    <!-- Play With Friends Modal -->
    <div id="friend-modal" class="editorial-modal-backdrop hidden">
        <div class="editorial-modal-box">
            <div class="modal-header-row" style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
                <div class="modal-protocol-tag" style="margin-bottom: 0;">PROTOCOL 02 // PRIVATE MATCH</div>
                <button type="button" id="close-friend-modal" class="btn-modal-close" aria-label="Close modal">&times;</button>
            </div>
            
            <h2 class="modal-headline modal-headline-sm" style="margin-bottom: 20px;">PLAY WITH A FRIEND</h2>

            <!-- Mode Tabs: Create vs Join -->
            <div class="friend-modal-tabs">
                <button type="button" class="friend-tab-btn active" id="tab-create-btn">CREATE ROOM</button>
                <button type="button" class="friend-tab-btn" id="tab-join-btn">JOIN WITH CODE</button>
            </div>

            <!-- Tab 1: Create Room Content -->
            <div id="tab-create-content" class="friend-tab-panel">
                <p class="modal-body-text" style="margin-bottom: 20px;">
                    Generate a unique 6-character room code. You will play as <strong>White</strong>; your friend will join with the code as <strong>Black</strong>.
                </p>
                <div class="friend-action-box">
                    <button type="button" id="generate-room-btn" class="btn-play-now" style="width: 100%; justify-content: center;">
                        <span>GENERATE CODE &amp; ENTER &rarr;</span>
                    </button>
                </div>
            </div>

            <!-- Tab 2: Join Room Content -->
            <div id="tab-join-content" class="friend-tab-panel hidden">
                <p class="modal-body-text" style="margin-bottom: 16px;">
                    Enter the team code provided by your friend to join their match as <strong>Black</strong>.
                </p>
                <form id="join-room-form" onsubmit="return false;">
                    <div class="friend-input-wrapper">
                        <input type="text" id="join-room-code-input" class="friend-code-input" placeholder="ENTER ROOM CODE" maxlength="16" autocomplete="off" spellcheck="false">
                    </div>
                    <div id="join-error-msg" class="friend-error-text hidden"></div>
                    <div class="friend-action-box" style="margin-top: 16px;">
                        <button type="submit" id="submit-join-btn" class="btn-play-now" style="width: 100%; justify-content: center;">
                            <span>JOIN MATCH &rarr;</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>

    <!-- Homepage interactive script (matrix hover + Enter/Space key launcher) -->
    <script src="/js/home.js"></script>
</body>

</html>