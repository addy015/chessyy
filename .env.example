# Server Port Configuration
PORT=3000

# Python AI Microservice URL
PYTHON_SERVICE_URL=http://127.0.0.1:8000

# Google Gemini API Key (Get a free key from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Local Stockfish Binary Path (optional if placed in system PATH or default directory)
# e.g., C:/stockfish/stockfish-windows-x86-64-avx2.exe
STOCKFISH_PATH=
